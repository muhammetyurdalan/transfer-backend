# Copy to /opt/transfer/env/backend.env and fill in.
# Generate random secrets with:  openssl rand -base64 48

# Security
SECRET_KEY=
JWT_SECRET=
FERNET_KEY=
ADMIN_CODE=
ALLOWED_HOSTS=api.cihanviptransfers.com
CORS_ALLOWED_ORIGINS=https://www.cihanviptransfers.com,https://cihanviptransfers.com
CSRF_TRUSTED_ORIGINS=https://api.cihanviptransfers.com

# Database (the postgres container; same values as postgres.env)
DB_NAME=transfer
DB_USER=transfer
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

# Redis (WebSocket + Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Payment microservice: keep the path of your current Vercel value,
# only replace the host with http://microservice:8080
PSP_MS_URL=http://microservice:8080
MS_ACCESS_TOKEN=
PSP_STATE=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Push notifications: put the Firebase JSON at /opt/transfer/firebase/credentials.json
# and uncomment the next line
# FIREBASE_CREDENTIALS=/app/firebase/credentials.json

# File storage (false = files stay on the server in the media volume)
USE_S3=false
