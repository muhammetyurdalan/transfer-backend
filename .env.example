# Security
ADMIN_CODE=072133
SECRET_KEY=
JWT_SECRET=
FERNET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL 15+)
DB_NAME=transfer
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Redis (dev/prod)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Payment Service (PSP microservice)
PSP_MS_URL=
MS_ACCESS_TOKEN=
PSP_STATE=TR

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@transfer.com

# Push notifications (FCM): path of the Firebase service account JSON, empty disables push
FIREBASE_CREDENTIALS=

# S3 file storage (USE_S3=true), otherwise local MEDIA_ROOT
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=false
